# Toolchain image: Conan 2 (Python-based) + C/C++ toolchain.
#
# Generic: CPython and the conan wheel set are pre-downloaded
# (fetch-artifacts.sh) and COPYed; the wheels are installed offline.
ARG BASE_IMAGE=toolchain-base:debian-trixie
FROM ${BASE_IMAGE}
COPY cache/cpython-3.14.7+20260901-x86_64-unknown-linux-gnu-install_only.tar.gz /tmp/py.tar.gz
COPY cache/conan-wheels-2.32.0.tar.gz /tmp/conan.tar.gz
RUN mkdir -p /opt && tar -xzf /tmp/py.tar.gz -C /opt \
 && mv /opt/python /opt/python-3.14.7 && ln -s /opt/python-3.14.7 /opt/python && rm /tmp/py.tar.gz \
 && mkdir -p /tmp/conan && tar -xzf /tmp/conan.tar.gz -C /tmp/conan \
 && /opt/python/bin/pip install --no-cache-dir --no-index --find-links /tmp/conan "conan==2.32.0" \
 && rm -rf /tmp/conan /tmp/conan.tar.gz
ENV PATH=/opt/python/bin:$PATH
