# Toolchain image: Node.js + npm/pnpm/yarn (corepack), Alpine/musl.
#
# Official Node releases are glibc-only, so the musl build (unofficial-builds)
# is pre-downloaded (fetch-artifacts.sh) and COPYed.
ARG BASE_IMAGE=toolchain-base:alpine-3.24
FROM ${BASE_IMAGE}
COPY cache/node-v26.8.2-linux-x64-musl.tar.xz /tmp/node.tar.xz
RUN mkdir -p /opt && tar -xJf /tmp/node.tar.xz -C /opt \
 && ln -s /opt/node-v26.8.2-linux-x64-musl /opt/node && rm /tmp/node.tar.xz
ENV PATH=/opt/node/bin:$PATH
# corepack shims need a writable dir; keep them on PATH.
RUN corepack enable --install-directory /usr/local/bin 2>/dev/null || true
