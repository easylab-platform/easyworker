# Toolchain image: Rust, Alpine (musl host toolchain from the dist tarball).
#
# The tarball is pre-downloaded (fetch-artifacts.sh) and COPYed.
ARG BASE_IMAGE=toolchain-base:alpine-3.24
FROM ${BASE_IMAGE}
COPY cache/rust-1.98.1-x86_64-unknown-linux-musl.tar.gz /tmp/rust.tar.gz
RUN mkdir -p /tmp/rustdist && tar -xzf /tmp/rust.tar.gz -C /tmp/rustdist --strip-components=1 && rm /tmp/rust.tar.gz \
 && /tmp/rustdist/install.sh --prefix=/opt/rust --without=rust-docs --disable-ldconfig && rm -rf /tmp/rustdist
ENV PATH=/opt/rust/bin:$PATH \
    CARGO_HOME=/root/.cargo
