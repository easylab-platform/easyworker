# Overrides go in ../urls.local.env (gitignored, e.g. written by mirror.sh).
#
# node: official releases are glibc-only; musl lives on unofficial-builds.
NODE_URL=https://unofficial-builds.nodejs.org/download/release/v26.8.2/node-v26.8.2-linux-x64-musl.tar.xz
GO_URL=https://go.dev/dl/go1.27.1.linux-amd64.tar.gz
# python/uv: python-build-standalone and uv both publish musl builds.
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260901/cpython-3.14.7+20260901-x86_64-unknown-linux-musl-install_only.tar.gz
UV_URL=https://github.com/astral-sh/uv/releases/download/0.12.14/uv-x86_64-unknown-linux-musl.tar.gz
# rust: the dist tarball ships a musl host toolchain.
RUST_URL=https://static.rust-lang.org/dist/2026-09-03/rust-1.98.1-x86_64-unknown-linux-musl.tar.gz
# jdk: Adoptium publishes an explicit alpine-linux (musl) build.
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_alpine-linux_hotspot_25.0.4.1_1.tar.gz
GRADLE_URL=https://services.gradle.org/distributions/gradle-9.7.1-bin.zip
# dotnet: musl build. NOTE: Alpine needs the icu-libs/openssl runtime packages.
DOTNET_URL=https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.401/dotnet-sdk-10.0.401-linux-musl-x64.tar.gz
# ruby: ruby-builder only publishes glibc builds, so alpine compiles from source.
RUBY_URL=https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.7.tar.gz
# php: static-php-cli publishes a statically linked CLI that runs on musl.
PHP_URL=https://dl.static-php.dev/static-php-cli/bulk/php-8.5.8-cli-linux-x86_64.tar.gz
COMPOSER_URL=https://getcomposer.org/download/2.10.3/composer.phar
# No alpine images for: swift (no musl toolchain), dart (no musl SDK),
# elixir (debian-only by decision), conda/pixi (conda packages are glibc-only:
# conda-forge ships no musl subdir, so even pixi's static musl binary cannot
# build an environment here).
# overridden per-libc in urls.local.env (CONAN_URL_MUSL)
# --- additional languages (musl-capable only) -------------------------------
# bun: upstream ships an explicit musl zip.
BUN_URL=https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-x64-musl.zip
# gleam/zig/crystal/opam/ghcup are statically linked musl binaries.
GLEAM_URL=https://github.com/gleam-lang/gleam/releases/download/v1.18.1/gleam-v1.18.1-x86_64-unknown-linux-musl.tar.gz
ZIG_URL=https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz
CRYSTAL_URL=https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-x86_64.tar.gz
OPAM_URL=https://github.com/ocaml/opam/releases/download/2.5.2/opam-2.5.2-x86_64-linux
GHCUP_URL=https://downloads.haskell.org/~ghcup/0.2.6.2/x86_64-linux-ghcup-0.2.6.2
# JVM languages: arch-independent archives; the alpine Temurin JDK is the parent.
KOTLIN_URL=https://github.com/JetBrains/kotlin/releases/download/v2.4.20/kotlin-compiler-2.4.20.zip
GROOVY_URL=https://groovy.jfrog.io/artifactory/dist-release-local/groovy-zips/apache-groovy-binary-4.0.33.zip
CLOJURE_URL=https://download.clojure.org/install/clojure-tools-1.12.0.1530.tar.gz
# scala-cli: the -pc-linux build is glibc; the -static build runs on musl.
SCALA_CLI_URL=https://github.com/VirtusLab/scala-cli/releases/download/v1.17.0/scala-cli-x86_64-pc-linux-static.gz
SBT_URL=https://github.com/sbt/sbt/releases/download/v1.11.6/sbt-1.11.6.tgz
# lua/luarocks are source builds (musl toolchain from the base image).
LUA_URL=https://www.lua.org/ftp/lua-5.4.7.tar.gz
LUAROCKS_URL=https://luarocks.github.io/luarocks/releases/luarocks-3.13.0.tar.gz
# No alpine images: deno (no musl build), julia (no musl build), swift/dart
# (glibc-only), r (source build needs a Fortran/musl toolchain stack),
# perl (the distro perl is the toolchain), conda/pixi (no musl conda packages).
CONAN_URL=https://artifacts.example.com/conan-wheels-2.32.0-musl.tar.gz
