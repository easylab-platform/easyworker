# Overrides go in ../urls.local.env (gitignored, e.g. written by mirror.sh).
#
# node: official releases are glibc-only; musl lives on unofficial-builds.
NODE_URL=https://unofficial-builds.nodejs.org/download/release/v26.8.2/node-v26.8.2-linux-x64-musl.tar.xz
GO_URL=https://go.dev/dl/go1.27.1.linux-amd64.tar.gz
# python/uv: python-build-standalone and uv both publish musl builds.
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260901/cpython-3.14.7+20260901-x86_64-unknown-linux-musl-install_only.tar.gz
UV_URL=https://github.com/astral-sh/uv/releases/download/0.12.14/uv-x86_64-unknown-linux-musl.tar.gz
# rust: the dist tarball ships a musl host toolchain.
RUST_URL=https://static.rust-lang.org/dist/2026-09-03/rust-1.98.1-x86_64-unknown-linux-musl.tar.gz
# jdk: Adoptium publishes an explicit alpine-linux (musl) build.
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_alpine-linux_hotspot_25.0.4.1_1.tar.gz
GRADLE_URL=https://services.gradle.org/distributions/gradle-9.7.1-bin.zip
# dotnet: musl build. NOTE: Alpine needs the icu-libs/openssl runtime packages.
DOTNET_URL=https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.401/dotnet-sdk-10.0.401-linux-musl-x64.tar.gz
# ruby: ruby-builder only publishes glibc builds, so alpine compiles from source.
RUBY_URL=https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.7.tar.gz
# php: static-php-cli publishes a statically linked CLI that runs on musl.
PHP_URL=https://dl.static-php.dev/static-php-cli/bulk/php-8.5.8-cli-linux-x86_64.tar.gz
COMPOSER_URL=https://getcomposer.org/download/2.10.3/composer.phar
# No alpine images for: swift (no musl toolchain), dart (glibc-only SDK),
# elixir (no alpine OTP build), conda (glibc-only payload).
# overridden per-libc in urls.local.env (CONAN_URL_MUSL)
CONAN_URL=https://artifacts.example.com/conan-wheels-2.32.0-musl.tar.gz
